<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Video Inject Tool</title>

  <style>
    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #111827, #1f2937, #000);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 520px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 22px;
      padding: 22px;
      backdrop-filter: blur(14px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    }

    h1 {
      text-align: center;
      font-size: 25px;
      margin-bottom: 5px;
    }

    .sub {
      text-align: center;
      color: #d1d5db;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .upload-box {
      border: 2px dashed rgba(255,255,255,0.35);
      border-radius: 18px;
      padding: 25px;
      text-align: center;
      cursor: pointer;
      transition: 0.2s;
      background: rgba(255,255,255,0.05);
    }

    .upload-box:hover {
      background: rgba(255,255,255,0.12);
    }

    input[type="file"] {
      display: none;
    }

    video {
      width: 100%;
      margin-top: 18px;
      border-radius: 16px;
      background: black;
      display: none;
    }

    .info {
      margin-top: 14px;
      font-size: 13px;
      color: #e5e7eb;
      line-height: 1.6;
      display: none;
      background: rgba(0,0,0,0.25);
      padding: 12px;
      border-radius: 12px;
    }

    .input-group {
      margin-top: 15px;
      display: none;
    }

    label {
      font-size: 14px;
      color: #e5e7eb;
    }

    input[type="text"] {
      width: 100%;
      margin-top: 7px;
      padding: 12px;
      border-radius: 12px;
      border: none;
      outline: none;
      font-size: 14px;
    }

    button {
      width: 100%;
      margin-top: 14px;
      padding: 14px;
      border: none;
      border-radius: 14px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      color: white;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      transition: 0.2s;
      display: none;
    }

    button:hover {
      opacity: 0.9;
      transform: scale(1.01);
    }

    .note {
      margin-top: 14px;
      font-size: 12px;
      color: #cbd5e1;
      text-align: center;
      line-height: 1.5;
    }

    .status {
      margin-top: 12px;
      text-align: center;
      font-size: 14px;
      color: #86efac;
      display: none;
    }

    .danger {
      color: #fca5a5;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>Video Inject Tool</h1>
    <p class="sub">Upload video, inject nama file, preview, lalu download ulang.</p>

    <label class="upload-box" for="videoInput">
      <strong>Tap untuk pilih video</strong>
      <br>
      <small>Format: MP4, MOV, WEBM</small>
    </label>

    <input type="file" id="videoInput" accept="video/*">

    <video id="videoPreview" controls></video>

    <div class="info" id="videoInfo"></div>

    <div class="input-group" id="renameBox">
      <label>Nama file hasil download:</label>
      <input type="text" id="fileNameInput" value="SAN_METHOD_INJECT_VIDEO.mp4">
    </div>

    <button id="injectBtn">Inject Video</button>
    <button id="downloadBtn">Download Video</button>

    <div class="status" id="statusText"></div>

    <p class="note">
      Tool ini berjalan langsung di browser. Video tidak dikirim ke server.
    </p>
  </div>

  <script>
    const videoInput = document.getElementById("videoInput");
    const videoPreview = document.getElementById("videoPreview");
    const videoInfo = document.getElementById("videoInfo");
    const renameBox = document.getElementById("renameBox");
    const fileNameInput = document.getElementById("fileNameInput");
    const injectBtn = document.getElementById("injectBtn");
    const downloadBtn = document.getElementById("downloadBtn");
    const statusText = document.getElementById("statusText");

    let selectedFile = null;
    let injectedBlob = null;
    let injectedUrl = null;

    videoInput.addEventListener("change", function () {
      selectedFile = this.files[0];

      if (!selectedFile) return;

      const videoUrl = URL.createObjectURL(selectedFile);
      videoPreview.src = videoUrl;
      videoPreview.style.display = "block";

      videoInfo.style.display = "block";
      renameBox.style.display = "block";
      injectBtn.style.display = "block";
      downloadBtn.style.display = "none";
      statusText.style.display = "none";

      videoInfo.innerHTML = `
        <strong>File:</strong> ${selectedFile.name}<br>
        <strong>Ukuran:</strong> ${formatSize(selectedFile.size)}<br>
        <strong>Tipe:</strong> ${selectedFile.type || "Tidak diketahui"}
      `;

      fileNameInput.value = makeSafeName(selectedFile.name);
    });

    injectBtn.addEventListener("click", async function () {
      if (!selectedFile) {
        alert("Pilih video dulu.");
        return;
      }

      statusText.style.display = "block";
      statusText.classList.remove("danger");
      statusText.innerText = "Sedang inject video...";

      try {
        const buffer = await selectedFile.arrayBuffer();

        const injectionText = `
SAN_METHOD_VIDEO_INJECT
DATE=${new Date().toISOString()}
DEVICE=WEB_BROWSER
QUALITY=HD_4K_READY
FPS=60_120FPS_READY
NO_COMPRESS_TAG=TRUE
`;

        const encoder = new TextEncoder();
        const injectData = encoder.encode(injectionText);

        const originalBytes = new Uint8Array(buffer);
        const finalBytes = new Uint8Array(originalBytes.length + injectData.length);

        finalBytes.set(originalBytes, 0);
        finalBytes.set(injectData, originalBytes.length);

        injectedBlob = new Blob([finalBytes], {
          type: selectedFile.type || "video/mp4"
        });

        if (injectedUrl) {
          URL.revokeObjectURL(injectedUrl);
        }

        injectedUrl = URL.createObjectURL(injectedBlob);

        statusText.innerText = "✅ Inject berhasil. Video siap didownload.";
        downloadBtn.style.display = "block";

      } catch (error) {
        statusText.classList.add("danger");
        statusText.innerText = "❌ Gagal inject video.";
        console.error(error);
      }
    });

    downloadBtn.addEventListener("click", function () {
      if (!injectedBlob) {
        alert("Inject video dulu.");
        return;
      }

      let fileName = fileNameInput.value.trim();

      if (!fileName) {
        fileName = "SAN_METHOD_INJECT_VIDEO.mp4";
      }

      if (!fileName.toLowerCase().endsWith(".mp4")) {
        fileName += ".mp4";
      }

      const a = document.createElement("a");
      a.href = injectedUrl;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      statusText.innerText = "✅ Download dimulai.";
    });

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + " KB";
      if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(2) + " MB";
      return (bytes / 1024 / 1024 / 1024).toFixed(2) + " GB";
    }

    function makeSafeName(name) {
      const cleanName = name
        .replace(/\.[^/.]+$/, "")
        .replace(/[^a-zA-Z0-9_-]/g, "_");

      return cleanName + "_SAN_METHOD_INJECT.mp4";
    }
  </script>

</body>
</html>
